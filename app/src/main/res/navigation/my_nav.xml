<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/my_nav"
    app:startDestination="@id/home2">

    <fragment
        android:id="@+id/home2"
        android:name="info.z10.z10mobile.Home"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/action_home2_to_kassenrechner"
            app:destination="@id/kassenrechner" />
        <action
            android:id="@+id/action_home2_to_inventur"
            app:destination="@id/inventur" />
    </fragment>

    <fragment
        android:id="@+id/kassenrechner"
        android:name="info.z10.z10mobile.Kassenrechner"
        android:label="fragment_kassenrechner"
        tools:layout="@layout/fragment_kassenrechner" />
    <fragment
        android:id="@+id/inventur"
        android:name="info.z10.z10mobile.Inventur"
        android:label="fragment_inventur"
        tools:layout="@layout/fragment_inventur" >
        <action
            android:id="@+id/action_inventur_to_inventur_addItem"
            app:destination="@id/inventur_addItem" />
    </fragment>
    <fragment
        android:id="@+id/inventur_addItem"
        android:name="info.z10.z10mobile.Inventur_Dinge.Inventur_AddItem"
        android:label="fragment_inventur"
        tools:layout="@layout/fragment_inventur_additem">
        <argument
            android:name="triggerScanningImmediately"
            app:argType="boolean"
            android:defaultValue="false" />
    </fragment>
</navigation>